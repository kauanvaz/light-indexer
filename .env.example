# light-indexer — configuracao por variaveis de ambiente
#
# Precedencia: variavel de ambiente > config/app.json > defaults do codigo.
# Nao ha segredos aqui (o produto nao usa credenciais).
# O `uv run` carrega este arquivo automaticamente na raiz do projeto.
#
# Copie este arquivo para `.env` e ajuste conforme o ambiente.
# Variaveis com valor vazio sao ignoradas (cai no default).

# --- Caminhos (defaults relativos a raiz do pacote) -------------------------

# Raiz do pacote. Em producao e detectada sozinha; defina so em dev/teste.
# default: autodetectada
# LIGHT_INDEXER_ROOT=

# Indice SQLite.
# default: <raiz>/data/indice.db
# LIGHT_INDEXER_DB=

# Acervo distribuido (documentos originais).
# default: <raiz>/documentos
# LIGHT_INDEXER_DOCS_DIR=

# Diretorio de logs.
# default: <raiz>/logs
# LIGHT_INDEXER_LOG_DIR=

# Estado de runtime (porta/PID). Fica fora da unidade.
# default: %LOCALAPPDATA%\light-indexer
# LIGHT_INDEXER_STATE_DIR=

# --- Servidor ---------------------------------------------------------------

# Porta preferida; usa a proxima livre se ocupada.
LIGHT_INDEXER_PORT=8765

# Endereco de escuta (nunca 0.0.0.0).
LIGHT_INDEXER_HOST=127.0.0.1

# Nivel de log: DEBUG | INFO | WARNING | ERROR.
LIGHT_INDEXER_LOG_LEVEL=INFO

# --- Instancia unica --------------------------------------------------------

# Nome do mutex nomeado. So para teste; em producao e derivado.
# default: derivado
# LIGHT_INDEXER_FORCE_MUTEX_NAME=
